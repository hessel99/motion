  "input": {
   "title": "Pulse logo sting",
   "duration": 8,
   "style": "Kinetic brand sting: springs and squash on the hit, expo-out entrances, one ease family",
   "styleReason": "A pulse brand wants rhythm: the mark breathes on the beat and lands on the drop.",
   "concepts": [
    {
     "name": "Heartbeat build",
     "idea": "The inner dot pulses on every beat, faster and tighter through the build (0-4 s), then the ring snaps open on the drop at 4.0 s and the wordmark follows.",
     "why": "The name is Pulse: the mark is literally a beat, so the sting is the heartbeat."
    },
    {
     "name": "Ripple drop",
     "idea": "The ring draws on during the build, then on the drop it bursts outward and ripples out as echo rings on the next beats.",
     "why": "Radiating rings read as a signal or pulse wave and carry the secondary hits."
    }
   ],
   "recommended": 0,
   "beats": [
    {
     "name": "Build",
     "start": 0,
     "end": 4,
     "description": "Ring draws on in a tight arc; inner dot pulses on every beat (0.5 s) with growing amplitude and speed. Wordmark hidden. Tension builds into the drop.",
     "style": "Dot pulses: Quad In/Out tight, amplitude grows. Ring drawn with trim."
    },
    {
     "name": "Drop landing",
     "start": 4,
     "end": 4.6,
     "description": "At 4.0 s (the drop) the ring snaps to full scale with a spring overshoot and the dot lands with squash. Wordmark 'Pulse' letters pop in from 4.2 s.",
     "style": "spring Bouncy on the ring, letters 0.04 s stagger, Expo Out."
    },
    {
     "name": "Secondary hits",
     "start": 4.5,
     "end": 6,
     "description": "Beats 4.5, 5.0, 5.5 punctuate with ripple echo rings expanding and fading out from the mark; a smaller hit at the 5.5 accent.",
     "style": "Echo rings Expo Out, fade out; mark scale nudges 102%."
    },
    {
     "name": "Lockup",
     "start": 6,
     "end": 8,
     "description": "Echoes stop. Mark and wordmark settle to the exact clean lockup at scale 100 and hold to the end.",
     "style": "Gentle settle, no motion in the final 1.5 s."
    }
   ]
  },
  "result": "storyboard \"Pulse logo sting\" shown to the user (4 beats, 8s). Auto-approved: build it now, beat by beat (update_progress {beat:1, status:\"active\"} … {status:\"done\"})."
