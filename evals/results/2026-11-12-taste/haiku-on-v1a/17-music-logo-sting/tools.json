   "title": "Pulse logo sting",
   "duration": 8,
   "style": "Kinetic brand sting: springs and expo eases, one red accent on near-black",
   "styleReason": "The brand is named Pulse and the track is 120 BPM, so the mark's own beat is the motion language.",
   "concepts": [
    {
     "name": "Heartbeat",
     "idea": "The inner dot beats on every music beat while the ring draws on; the build tightens the ring; on the drop (4.0 s) the mark lands and bursts ripples out of the dot.",
     "why": "The name is Pulse: the mark literally pulses with the track."
    },
    {
     "name": "Orbit lock",
     "idea": "A dot orbits inside the ring, speeding up through the build, and locks to the ring's edge on the drop; the wordmark follows.",
     "why": "Clear geometric story: a dot finding its orbit."
    }
   ],
   "recommended": 0,
   "beats": [
