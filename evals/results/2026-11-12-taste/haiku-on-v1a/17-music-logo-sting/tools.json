    },
    {
     "name": "Lockup hold",
     "start": 6.6,
     "end": 8,
     "description": "Everything rests at 100%: clean lockup, mark plus Pulse wordmark, nothing moves.",
     "style": "Static hold to comp end."
    }
   ]
  },
