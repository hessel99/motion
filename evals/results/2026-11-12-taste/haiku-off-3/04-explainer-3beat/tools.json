    },
    {
     "name": "Resolve",
     "start": 8,
     "end": 12,
     "description": "The shield glows (amber soft ring behind it pulses once), a check mark draws on beside it, and the headline 'One key. Every login.' lands below with a line-by-line rise. Final frame holds.",
     "style": "Check trimEnd draw Cubic In Out 0.5s; headline Inter 700 ~76px, lines rise with Quart Out."
    }
   ]
  },
