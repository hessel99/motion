{
  "name": "motion",
  "version": "0.1.0",
  "private": true,
  "description": "high-performance motion design editor (after effects style) with ai agent sidebar",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "node bridge/server.mjs",
    "electron": "npm run build && electron .",
    "electron:dev": "electron . --dev",
    "bench": "node scripts/bench.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "stress": "vite build && node scripts/stress-lab.mjs",
    "stress:quick": "vite build && node scripts/stress-lab.mjs --quick"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@preact/signals": "^1.3.0",
    "fflate": "^0.8.2",
    "fzstd": "^0.1.1",
    "gifenc": "^1.0.3",
    "kiwi-schema": "^0.5.0",
    "mediabunny": "^1.65.2",
    "opentype.js": "^1.3.4",
    "preact": "^10.24.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "app.motion.editor",
    "productName": "Motion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bridge/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bridge/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "author": "Motion"
}
